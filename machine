#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -f "$root/machines.env" ]; then
  set -a
  # shellcheck source=/dev/null
  source "$root/machines.env"
  set +a
fi
source "$root/bootstrap.sh"
role=${1:-dev}
action=${2:-status}
case "$role" in
  dev) name=${MACHINES_DEV_NAME:-dev-build}; username=${MACHINES_USER:-developer}; port=2223; cpus=${MACHINES_DEV_CPUS:-8}; memory=${MACHINES_DEV_MEMORY:-10G} ;;
  target) name=${MACHINES_TARGET_NAME:-deployment-target}; username=root; port=2222; cpus=${MACHINES_TARGET_CPUS:-4}; memory=${MACHINES_TARGET_MEMORY:-8G} ;;
  *) echo 'Expected dev or target' >&2; exit 2 ;;
esac
# These values are interpolated into guest shell commands.
[[ "$name" =~ ^[a-zA-Z0-9_-]+$ && "$username" =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 2
keys="$store/ssh/$role"
dev_guest() {
  "$cli" machine run -i -n "${MACHINES_DEV_NAME:-dev-build}" -- "
    set -e
    export PATH=/nix/var/nix/profiles/system/sw/bin:/run/current-system/sw/bin
    $1
  "
}
case "$action" in
  pull) setup; load_release; pull_image ;;
  up) up ;;
  pair)
    test "$role" = target
    # Generate deployment credentials in the dev VM; only its public key leaves it.
    dev_guest '
      install -d -m 700 ~/.local/share/machines/target
      test -f ~/.local/share/machines/target/id_ed25519 ||
        ssh-keygen -q -t ed25519 -N "" -f ~/.local/share/machines/target/id_ed25519
    ' </dev/null
    dev_guest 'cat ~/.local/share/machines/target/id_ed25519.pub' </dev/null | authorize
    host_address=$(address)
    { printf '[%s]:%s ' "$host_address" "$port"; guest 'cat /etc/ssh/ssh_host_ed25519_key.pub'; } |
      dev_guest '
        cat > ~/.local/share/machines/target/known_hosts
        chmod 600 ~/.local/share/machines/target/known_hosts
      '
    # Tilde paths are expanded by OpenSSH in the guest, not by the Mac shell.
    # shellcheck disable=SC2088
    ssh_config "$host_address" root "$port" '~/.local/share/machines/target/id_ed25519' '~/.local/share/machines/target/known_hosts' |
      dev_guest '
        cat > ~/.local/share/machines/target/ssh_config
        chmod 600 ~/.local/share/machines/target/ssh_config
      '
    dev_guest 'ssh -n -F ~/.local/share/machines/target/ssh_config target hostname' </dev/null
    echo 'In the development machine: ssh -F ~/.local/share/machines/target/ssh_config target'
    ;;
  shell) exec "$cli" machine run -it -n "$name" </dev/tty ;;
  forward)
    if [ "$role" = dev ]; then
      local_port=${MACHINES_DEV_LOCAL_PORT:-18081}; remote_port=${MACHINES_DEV_REMOTE_PORT:-80}
    else
      local_port=${MACHINES_TARGET_LOCAL_PORT:-18080}; remote_port=${MACHINES_TARGET_REMOTE_PORT:-80}
    fi
    [[ "$local_port" =~ ^[0-9]+$ && "$remote_port" =~ ^[0-9]+$ ]] || exit 2
    exec ssh -F "$keys/config" -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
      -L "127.0.0.1:$local_port:127.0.0.1:$remote_port" "$role"
    ;;
  status)
    "$cli" machine inspect "$name"
    guest 'hostname; systemctl --failed --no-pager' </dev/null
    ;;
  stop) "$cli" machine stop "$name" ;;
  *) echo 'Usage: machine dev|target up|pull|pair|shell|forward|status|stop' >&2; exit 2 ;;
esac
